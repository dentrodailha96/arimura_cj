<?php
    include("db_connection.php");
    
    // Get the product ID and new values from the form
    $id         = $_REQUEST['p_id_product'];
    $name       = $_REQUEST['p_nome'];
    $price      = $_REQUEST['p_price_product'];
    $sales_unit = $_REQUEST['p_sales_unit'];
    
    // SQL UPDATE query
    $textsql = "UPDATE products 
                SET name = '$name', 
                    price_product = '$price', 
                    sales_unit = '$sales_unit', 
                    last_modified = now() 
                WHERE id = $id";
    
    // Debugging: print the query
    echo "Executing: " . $textsql . "<br>";
    
    // Execute the query
    $result = pg_query($con, $textsql);
    
    if (!$result) {
        echo "An error occurred during the update.<br>";
        echo "PostgreSQL Error: " . pg_last_error($con) . "<br>";
        exit;
    }
    
    // Check how many rows were affected
    $affected_rows = pg_affected_rows($result);
    
    if ($affected_rows > 0) {
        echo "Product updated successfully! ($affected_rows row(s) affected)";
    } else {
        echo "No product was updated. Maybe the ID doesn't exist?";
    }
    
    pg_close($con);
?>